  </ItemGroup>

  <!-- Real catalogs + test fixture embedded under the plugin's LogicalName convention -->
  <ItemGroup>
    <!-- WithCulture="false" — AssignCulture would otherwise route strings.<lc>.json
         into satellite *.resources.dll assemblies instead of the main manifest. -->
    <EmbeddedResource Include="..\..\src\shared\Localization\Catalog\strings.*.json" WithCulture="false" Link="Shared\Localization\Catalog\%(Filename)%(Extension)">
      <LogicalName>RvtMcp.Localization.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\shared\Localization\ToolSummaries\summary.*.json" WithCulture="false" Link="Shared\Localization\ToolSummaries\%(Filename)%(Extension)">
      <LogicalName>RvtMcp.ToolSummaries.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Catalog\strings.tt.json" WithCulture="false">
      <LogicalName>RvtMcp.Localization.strings.tt.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Own obj: the solution also builds the server with default properties, and a shared
       obj lets parallel builds collide on its files (MSB3371). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\server\RvtMcp.Server.csproj">
      <AdditionalProperties>UseAppHost=false;OutputPath=$(MSBuildThisFileDirectory)..\server-staging\;IntermediateOutputPath=$(MSBuildThisFileDirectory)..\server-staging\obj\$(Configuration)\</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Security.Principal.Windows" Version="5.0.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
