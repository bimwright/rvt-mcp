    <Compile Include="../../src/shared/Views/Toast/ToastActivityEntry.cs" Link="Shared/Views/Toast/ToastActivityEntry.cs" />
    <Compile Include="../../src/shared/Infrastructure/HostHealthSnapshot.cs" Link="Shared/Infrastructure/HostHealthSnapshot.cs" />
