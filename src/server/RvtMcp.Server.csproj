<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RvtMcp.Server</RootNamespace>
    <AssemblyName>RvtMcp.Server</AssemblyName>
    <LangVersion>latest</LangVersion>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!-- NuGet .NET tool packaging (P4-001) -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rvt-mcp</ToolCommandName>
    <PackageId>RvtMcp.Server</PackageId>
    <Version>1.1.0</Version>
    <Authors>Khoa Le</Authors>
    <Description>MCP gateway for Autodesk Revit 2022-2027 — expose the Revit API as AI-callable tools with progressive disclosure (toolset gating), a Transaction-safe batch_execute, and a ToolBaker self-evolution engine. Pair with the Revit plugin distributed on GitHub Releases.</Description>
    <PackageProjectUrl>https://github.com/bimwright/rvt-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bimwright/rvt-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>mcp;revit;bim;ai</PackageTags>
    <Copyright>Copyright 2026 Khoa Le</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Shared config (A9) — pulled in as source so server binary has zero extra deps -->
  <ItemGroup>
    <Compile Include="..\shared\Failures\FailureContracts.cs" Link="Shared\Failures\FailureContracts.cs" />
    <Compile Include="..\shared\Failures\FailureCompletion.cs" Link="Shared\Failures\FailureCompletion.cs" />
    <Compile Include="..\shared\Failures\FailurePolicy.cs" Link="Shared\Failures\FailurePolicy.cs" />
    <Compile Include="..\shared\Failures\FailureCapture.cs" Link="Shared\Failures\FailureCapture.cs" />
    <Compile Include="..\shared\Failures\FailureLedgerStore.cs" Link="Shared\Failures\FailureLedgerStore.cs" />
    <Compile Include="..\shared\Failures\RevitMessageCatalogModel.cs" Link="Shared\Failures\RevitMessageCatalogModel.cs" />
    <Compile Include="..\shared\Config\RvtMcpConfig.cs" Link="Shared\Config\RvtMcpConfig.cs" />
    <Compile Include="..\shared\Config\ToastPositionOptions.cs" Link="Shared\Config\ToastPositionOptions.cs" />
    <Compile Include="..\shared\Logging\PersistSendCodeTtl.cs" Link="Shared\Logging\PersistSendCodeTtl.cs" />
    <Compile Include="..\shared\Security\BakeRedactor.cs" Link="Shared\Security\BakeRedactor.cs" />
    <Compile Include="..\shared\Security\SecretMasker.cs" Link="Shared\Security\SecretMasker.cs" />
    <Compile Include="..\shared\ToolBaker\BakedToolRecord.cs" Link="Shared\ToolBaker\BakedToolRecord.cs" />
    <Compile Include="..\shared\ToolBaker\BakedToolRuntimeSource.cs" Link="Shared\ToolBaker\BakedToolRuntimeSource.cs" />
    <Compile Include="..\shared\Infrastructure\LegacyDataMigration.cs" Link="Shared\Infrastructure\LegacyDataMigration.cs" />
    <Compile Include="..\shared\Infrastructure\ToolReadPolicy.cs" Link="Shared\Infrastructure\ToolReadPolicy.cs" />
    <Compile Include="..\shared\Survey\SurveyContract.cs" Link="Shared\Survey\SurveyContract.cs" />
    <Compile Include="..\shared\Survey\SurveySnapshotCache.cs" Link="Shared\Survey\SurveySnapshotCache.cs" />
    <Compile Include="..\shared\Infrastructure\Responses\ResponseSizeGuard.cs" Link="Shared\Infrastructure\Responses\ResponseSizeGuard.cs" />
    <Compile Include="..\shared\Infrastructure\Responses\ResponseSizePolicyCatalog.cs" Link="Shared\Infrastructure\Responses\ResponseSizePolicyCatalog.cs" />
    <Compile Include="..\shared\Infrastructure\Responses\MutationResponseCompactor.cs" Link="Shared\Infrastructure\Responses\MutationResponseCompactor.cs" />
    <Compile Include="..\shared\Infrastructure\Responses\ResponseSpillWriter.cs" Link="Shared\Infrastructure\Responses\ResponseSpillWriter.cs" />
    <Compile Include="..\shared\Infrastructure\Responses\ResponseSpillPolicy.cs" Link="Shared\Infrastructure\Responses\ResponseSpillPolicy.cs" />
    <Compile Include="..\shared\Infrastructure\Responses\ResponseSpillProcessor.cs" Link="Shared\Infrastructure\Responses\ResponseSpillProcessor.cs" />
    <Compile Include="..\shared\Infrastructure\Responses\ResponseEnvelopeGuard.cs" Link="Shared\Infrastructure\Responses\ResponseEnvelopeGuard.cs" />
    <Compile Include="..\shared\Infrastructure\Responses\SafetyResponseMetadata.cs" Link="Shared\Infrastructure\Responses\SafetyResponseMetadata.cs" />
    <Compile Include="..\shared\Infrastructure\ChangeTracking\DocumentChangeAccumulator.cs" Link="Shared\Infrastructure\ChangeTracking\DocumentChangeAccumulator.cs" />
    <Compile Include="..\shared\Infrastructure\ChangeTracking\ChangeSummary.cs" Link="Shared\Infrastructure\ChangeTracking\ChangeSummary.cs" />
    <Compile Include="..\shared\Infrastructure\ChangeTracking\ChangeHistoryTransfer.cs" Link="Shared\Infrastructure\ChangeTracking\ChangeHistoryTransfer.cs" />
    <Compile Include="..\shared\Infrastructure\ChangeTracking\HistoryDiagnostics.cs" Link="Shared\Infrastructure\ChangeTracking\HistoryDiagnostics.cs" />
    <Compile Include="..\shared\Infrastructure\ChangeTracking\HistoryFileIdentity.cs" Link="Shared\Infrastructure\ChangeTracking\HistoryFileIdentity.cs" />
    <Compile Include="..\shared\Views\Toast\ToolActivityClassifier.cs" Link="Shared\Views\Toast\ToolActivityClassifier.cs" />
    <Compile Include="..\shared\Security\McpResponsePrivacy.cs" Link="Shared\Security\McpResponsePrivacy.cs" />
    <Compile Include="..\shared\Security\ErrorSanitizer.cs" Link="Shared\Security\ErrorSanitizer.cs" />
    <Compile Include="..\shared\ToolCatalog\ToolCatalogModels.cs" Link="Shared\ToolCatalog\ToolCatalogModels.cs" />
    <Compile Include="..\shared\Update\UpdateCheck.cs" Link="Shared\Update\UpdateCheck.cs" />
  </ItemGroup>

  <!-- Prompt bodies (D1): embedded markdown, stable LogicalName like the localization catalogs -->
  <ItemGroup>
    <EmbeddedResource Include="Prompts\*.md">
      <LogicalName>RvtMcp.Prompts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Expose internal helpers (ParseCsv, ApplyCliArgs, ApplyEnvVars, Load overloads, etc.)
       to the test project. Required for RvtMcpConfigTests + ToolsListSnapshotTests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="RvtMcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <!-- Pin patched native SQLite without changing managed assembly bindings. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
